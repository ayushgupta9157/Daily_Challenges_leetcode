class Solution {
    public int[] resultArray(int[] nums) {
        int n = nums.length;
        List<Integer> l1 = new ArrayList<>();
        l1.add(nums[0]);
        List<Integer> l2 = new ArrayList<>();
        l2.add(nums[1]);
        for(int i=2;i<n;i++){
            if(l1.get(l1.size()-1)>=l2.get(l2.size()-1)){
                l1.add(nums[i]);
            }
            else{
                l2.add(nums[i]);
            }
        }
        int[] arr = new int[n];
        int i=0,k=0,j=0;
        while(i<l1.size()){
            arr[k]=l1.get(i);
            i++;
            k++;
        }
        while(j<l2.size()){
            arr[k]=l2.get(j);
            j++;
            k++;
        }
        return arr;
    }
}
