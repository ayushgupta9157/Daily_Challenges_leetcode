class Solution {
    public int missingInteger(int[] nums) {
        int n = nums.length;
        List<Integer> l = new ArrayList<>();
        int sum=0;
        sum=nums[0];
        for(int i=1;i<n;i++){
            if(nums[i]==nums[i-1]+1){
                sum=sum+nums[i];
            }
            else{
                break;
            }
        }
        for(int num:nums){
            l.add(num);
        }
        while (l.contains(sum)) {
            sum++;
        }
        return sum;
    }
}
